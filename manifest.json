{
    "manifest_version": 3,

    "name": "Pasta Time !",
    "description": "Pour gagner un peu de temps (quelques heures seulement) quand il faut rentrer des données à la main",
    "version": "0.1",

    "icons": {
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png"
    },

    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "tabs",
        "sidePanel"
    ],

    "sidebar_action": {
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        },
        "default_title": "Pasta Time",
        "default_panel": "panel/panel.html",
        "open_at_install": false
    },

    "side_panel": {
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        },
        "default_title": "Pasta Time",
        "default_path": "panel/panel.html",
        "open_at_install": false
    },

    "content_scripts": [
        {
            "matches": [
                "*://croixrouge-x3-prd.em.cloud-by-sage.fr/*",
                "*://gaia.croix-rouge.fr/*"
            ],
            "js": [
                "utils/messaging.js",
                "utils/actions.js",
                "content/ContentStore.js",
                "content/FieldSearcher.js",
                "content/FillMethod.js",
                "content/Engine.js",
                "content/Cursor.js"
            ]
        },
        {
            "matches": [
                "*://croixrouge-x3-prd.em.cloud-by-sage.fr/*"
            ],
            "js": [
                "content/sites/aida/AidaEngine.js"
            ]
        },
        {
            "matches": [
                "*://gaia.croix-rouge.fr/*"
            ],
            "js": [
                "content/sites/gaia/GaiaFillMethods.js",
                "content/sites/gaia/GaiaEngine.js"
            ]
        }
    ],

    "background": {
        "service_worker": "background.js",
        "scripts": ["utils/messaging.js", "background.js"]
    },

    "commands": {
        "previous": {
            "suggested_key": {
                "default": "Ctrl+Left"
            },
            "description": "Champ précédent"
        },
        "next": {
            "suggested_key": {
                "default": "Ctrl+Right"
            },
            "description": "Champ suivant"
        },
        "enter": {
            "suggested_key": {
                "default": "Ctrl+E"
            },
            "description": "Entrer le champ"
        },
        "continue": {
            "description": "Page suivante"
        },
        "new": {
            "description": "Nouveau"
        },
        "save": {
            "description": "Sauvegarder"
        },
        "cancel": {
            "description": "Annuler"
        }
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "pastatime@mozilla.org",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "web_accessible_resources": [
        {
            "resources": [
                "resources/sites/aida/*.json"
            ],
            "matches": [
                "*://croixrouge-x3-prd.em.cloud-by-sage.fr/*"
            ]
        },
        {
            "resources": [
                "resources/sites/gaia/*.json"
            ],
            "matches": [
                "*://gaia.croix-rouge.fr/*"
            ]
        }
    ]
}